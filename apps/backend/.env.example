# Backend settings. Copy to .env (`cp .env.example .env`) and adjust.
# Every key carries the BE_ prefix; real environment variables override this file.
# Use another file with BE_ENV_FILE=.env.staging. Lists: comma-separated or JSON arrays.
# Defaults below are safe for LOCAL DEVELOPMENT ONLY (Mongo + Redis on localhost).

# ------------------------------------------------------------------ app
BE_APP_NAME=App
BE_APP_VERSION=1.0.0
# development | test | staging | production (production enforces secure cookies & real secrets)
BE_ENVIRONMENT=development
BE_HOST=0.0.0.0
BE_PORT=8020
BE_WORKERS=1
BE_RELOAD=false
# Prefix when served behind a path-rewriting proxy (usually empty: the proxy strips /api/v1/apps)
BE_ROOT_PATH=
BE_DOCS_ENABLED=true
# Max concurrent sync routes/dependencies (anyio thread limiter)
BE_THREADPOOL_SIZE=40
# Exact router names to mount; empty = all (health, auth, user, group, permission, role, upload)
BE_ENABLED_ROUTERS=
# Base URL of the web app (used in email links)
BE_PUBLIC_WEB_URL=http://localhost:3000

# -------------------------------------------------------------- logging
# TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
BE_LOG_LEVEL=INFO
BE_LOG_JSON=false
BE_ACCESS_LOG=true

# ------------------------------------------------------------- database
# mongo | supabase
BE_DB_PROVIDER=mongo
BE_MONGO_URI=mongodb://localhost:27017
BE_MONGO_DB=app
BE_MONGO_TIMEOUT_MS=5000

# Supabase / Postgres (required when BE_DB_PROVIDER=supabase; apply migrations/supabase/*.sql first)
BE_SUPABASE_URL=
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
BE_SUPABASE_DB_URL=
BE_SUPABASE_DB_SCHEMA=public
BE_SUPABASE_DB_POOL_MIN=1
BE_SUPABASE_DB_POOL_MAX=10
BE_SUPABASE_DB_TIMEOUT=10

# Table (Postgres) / collection (Mongo) names
BE_TABLE_USERS=users
BE_TABLE_PERMISSIONS=permissions
BE_TABLE_GROUPS=groups
BE_TABLE_ROLES=roles
BE_TABLE_UPLOADS=uploads

# ---------------------------------------------------------------- redis
# BE_REDIS_URL (redis://:pass@host:6379/0, rediss:// for TLS) wins over host/port/password/db
BE_REDIS_URL=
BE_REDIS_HOST=localhost
BE_REDIS_PORT=6379
BE_REDIS_PASSWORD=
BE_REDIS_DB=0
BE_REDIS_SSL=false
BE_REDIS_KEY_PREFIX=app

# ----------------------------------------------------------------- auth
# local (own JWT + login/register/OTP) | supabase (verify Supabase-issued JWTs)
BE_AUTH_PROVIDER=local
# >= 32 chars. Generate: openssl rand -hex 32  (the placeholder is rejected in production)
BE_JWT_SECRET=change-me-dev-only-jwt-secret-0123456789abcdef
# HS256 | HS384 | HS512
BE_JWT_ALGORITHM=HS256
BE_JWT_ISSUER=app
# seconds
BE_JWT_ACCESS_TTL=900
BE_JWT_REFRESH_TTL=604800
BE_JWT_LEEWAY=10
# Cookies: `token` (access) + `refresh_token`. Secure must be true in production (HTTPS).
BE_COOKIE_SECURE=false
# lax | strict | none (none requires secure)
BE_COOKIE_SAMESITE=lax
BE_COOKIE_DOMAIN=
BE_COOKIE_REFRESH_PATH=/
# System-to-system header X-Internal-Token (>= 32 chars); empty = disabled
BE_INTERNAL_TOKEN=
# Permission aliases treated as superuser
BE_SUPERUSER_ALIASES=admin,owner
# Permission alias assigned to self-registered / auto-provisioned users
BE_DEFAULT_PERMISSION_ALIAS=user
BE_PASSWORD_MIN_LENGTH=8
BE_ACCOUNT_LOCK_MAX_ATTEMPTS=5
BE_ACCOUNT_LOCK_SECONDS=900
BE_OTP_LENGTH=6
BE_OTP_TTL=600
BE_OTP_MAX_ATTEMPTS=5
BE_OTP_RESEND_COOLDOWN=60
BE_TWO_FACTOR_SESSION_TTL=300
# Issuer shown in authenticator apps (default: BE_APP_NAME)
BE_TOTP_ISSUER=
# Google sign-in (code exchange); both empty = endpoint not mounted
BE_GOOGLE_CLIENT_ID=
BE_GOOGLE_CLIENT_SECRET=

# Supabase auth (BE_AUTH_PROVIDER=supabase): JWKS (asymmetric keys) OR legacy HS256 secret
# BE_SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
BE_SUPABASE_JWKS_URL=
BE_SUPABASE_JWT_SECRET=
BE_SUPABASE_JWT_AUDIENCE=authenticated
# Optional issuer check, e.g. https://<ref>.supabase.co/auth/v1
BE_SUPABASE_JWT_ISSUER=

# Seed (`python -m scripts.seed`) bootstrap admin
BE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BE_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BE_BOOTSTRAP_ADMIN_USERNAME=admin
BE_BOOTSTRAP_ADMIN_FULLNAME=Administrator

# ------------------------------------------------------------ http/cors
# Explicit origins only ('*' is rejected because cookies are used)
BE_CORS_ORIGINS=http://localhost:3000
# Honour X-Forwarded-For for client IPs (only behind a trusted reverse proxy)
BE_TRUST_PROXY_HEADERS=false
BE_PROXY_TRUSTED_HOPS=1

# ----------------------------------------------------------- rate limit
BE_RATE_LIMIT_ENABLED=true
# Global per-client budget per window; 0 = off
BE_RATE_LIMIT_GLOBAL=0
BE_RATE_LIMIT_WINDOW=60
# Sensitive endpoints (login, OTP, password reset): requests per client per window
BE_RATE_LIMIT_AUTH=10
BE_RATE_LIMIT_AUTH_WINDOW=60
BE_MAX_PAGE_SIZE=100

# ----------------------------------------------------------- encryption
# Fernet key for secrets at rest (TOTP secrets). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BE_DATA_ENCRYPTION_KEY=
# Optional AES-256-GCM payload encryption ({"payload": "<b64>"} in and out)
BE_ENC_ACTIVE=false
# base64 of 32 random bytes: openssl rand -base64 32
BE_ENC_SECRET=

# --------------------------------------------------------------- upload
BE_UPLOAD_MAX_SIZE_MB=25
BE_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,text/csv,application/json,application/zip,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation
BE_UPLOAD_IMAGE_MAX_DIMENSION=2048
BE_UPLOAD_KEY_PREFIX=uploads

# ------------------------------------- S3 (AWS / MinIO / Supabase Storage)
# Supabase Storage: https://<ref>.supabase.co/storage/v1/s3 ; MinIO: http://localhost:9000
BE_S3_ENDPOINT_URL=
BE_S3_REGION=us-east-1
BE_S3_ACCESS_KEY_ID=
BE_S3_SECRET_ACCESS_KEY=
BE_S3_BUCKET=
BE_S3_FORCE_PATH_STYLE=true
BE_S3_PRESIGN_TTL=900

# ---------------------------------------------------------------- kafka
# Optional; empty = disabled
BE_KAFKA_BOOTSTRAP_SERVERS=
BE_KAFKA_CLIENT_ID=
BE_KAFKA_TOPIC_FILE_EXTRACTION=

# ----------------------------------------------------------------- smtp
# Optional. Without SMTP, development logs emails to the console (BE_EMAIL_BACKEND=auto);
# production without SMTP answers email-based flows with CONFIGURATION_ERROR (503).
BE_SMTP_HOST=
# 587 + STARTTLS (default) or 465 + BE_SMTP_SSL=true (implicit TLS; STARTTLS is then ignored)
BE_SMTP_PORT=587
BE_SMTP_USERNAME=
BE_SMTP_PASSWORD=
BE_SMTP_STARTTLS=true
BE_SMTP_SSL=false
BE_SMTP_FROM_EMAIL=
# Display name of the sender (default: BE_APP_NAME)
BE_SMTP_FROM_NAME=
BE_SMTP_TIMEOUT=10

# ------------------------------------------------------- email delivery
# auto (smtp if configured, else console in dev / disabled in production) | smtp | console | disabled
# console prints messages (including one-time codes) to the log: never use it in production.
BE_EMAIL_BACKEND=auto
# Folder with <name>.txt (first line "Subject: ...") and optional <name>.html; copy templates/email to localize
BE_EMAIL_TEMPLATES_DIR=

# ------------------------------------------------ auth flows (local auth)
# Self-service sign-up (POST /auth/register)
BE_REGISTRATION_ENABLED=true
# Seconds after which an unverified (pending) account may be replaced by a new sign-up
BE_REGISTRATION_PENDING_TTL=86400
# Email-verification links: lifetime (seconds) and web route that receives ?token=
BE_EMAIL_VERIFY_TTL=86400
BE_EMAIL_VERIFY_PATH=/auth/verify-email
# Web sign-in route used in emails (e.g. the "account already exists" notice)
BE_WEB_LOGIN_PATH=/auth/login
# Google sign-in: create an account on first sign-in (otherwise only existing accounts can use Google)
BE_GOOGLE_AUTO_REGISTER=false
# Restrict Google sign-in to these email domains (comma list; empty = any)
BE_GOOGLE_ALLOWED_DOMAINS=
BE_GOOGLE_HTTP_TIMEOUT=10
