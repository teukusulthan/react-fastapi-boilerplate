{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/scripts/py.mjs"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)",
      "!{projectRoot}/src/test/**/*",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/project.json"
    ]
  },
  "targetDefaults": {
    "serve": {
      "cache": false,
      "continuous": true
    },
    "lint": {
      "cache": true,
      "inputs": ["default"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default"]
    },
    "build": {
      "cache": true,
      "inputs": ["production"]
    },
    "format": {
      "cache": false
    },
    "format-check": {
      "cache": true,
      "inputs": ["default"]
    }
  },
  "neverConnectToCloud": true,
  "analytics": false
}
